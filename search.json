---
layout: null
permalink: /search.json
sitemap: false
---
[
  {%- for post in site.posts %}
  {
    "url": {{ post.url | relative_url | jsonify }},
    "keywords": {{ post.tags | concat: post.categories | join: ' ' | jsonify }},
    "content": {{ post.content | markdownify | replace: '</', ' </' | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
]
